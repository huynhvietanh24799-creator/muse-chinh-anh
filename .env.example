# Copy file này thành .env khi chạy thử trên máy bạn. KHÔNG commit file .env lên GitHub.
# Trên Render thì điền các giá trị này trong mục Environment.
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# Lấy bằng: npm run get-token (xem README, bước 3)
GOOGLE_REFRESH_TOKEN=
# ID thư mục "Đơn chỉnh ảnh AI" trên Drive (đoạn sau /folders/ trên thanh địa chỉ)
DRIVE_ROOT_FOLDER_ID=ID_cua_thu_muc_Don_chinh_anh_AI
# Chuỗi ngẫu nhiên dài để dịch vụ ping gọi /api/cleanup (ví dụ chạy: openssl rand -hex 24)
CLEANUP_KEY=
# Giữ đơn bao nhiêu giờ trước khi xóa (48 = 2 ngày)
RETENTION_HOURS=48
# true = thợ tự động chỉ làm khi bạn tạo file da-duyet.txt trong thư mục đơn
REQUIRE_APPROVAL=false
# Mặc định false: web chỉ nhận đơn và giao ảnh; Muse của bạn (bên ngoài) tự làm ảnh.
# true = máy chủ tự chỉnh ánh sáng bằng thợ tự động có sẵn (tùy chọn, không dùng AI)
AUTO_MUSE=false
# Cạnh dài tối đa khi chỉnh trên máy chủ miễn phí (ít bộ nhớ)
RELIGHT_MAX_EDGE=3000
# Địa chỉ trang web của bạn (để ghi link theo dõi vào danh sách cần nhắn Zalo)
SITE_URL=
PORT=3000
